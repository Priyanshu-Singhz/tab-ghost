{
  "manifest_version": 3,
  "name": "Tab Ghost",
  "version": "1.0.0",
  "description": "Closed tabs come back as friendly ghosts at the edge of your screen. Click one to resurrect it.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tab Ghost",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}